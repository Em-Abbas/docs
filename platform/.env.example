# --- Required ---------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgres://kiosk:kiosk@localhost:5432/kiosk
# 32+ random characters. Encrypts authenticator secrets and signs login steps.
# Generate with: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Public URL of the site (used in emails)
APP_URL=http://localhost:3000

# --- First admin (created by `npm run db:seed`) ------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now

# --- File storage -------------------------------------------------------------
# Where product images, receipts and item files are stored on disk
STORAGE_DIR=./storage

# --- Email (admin notifications) ----------------------------------------------
# Leave SMTP_URL empty to print emails to the server log instead of sending.
# Example: smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Kiosk <no-reply@example.com>"

# --- Optional -----------------------------------------------------------------
# Secret for the maintenance endpoint (GET /api/cron?key=...). Releases reseller
# earnings and expires stale deposits. Call it every few minutes from a scheduler.
CRON_SECRET=
# Seed demo categories, products and inventory (true/false)
SEED_DEMO=true
